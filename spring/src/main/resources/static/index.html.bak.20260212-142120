<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Backend API Test (Vue + Tailwind CDN)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <div id="app" class="max-w-2xl mx-auto p-6">
      <div class="bg-white rounded-2xl shadow p-6 space-y-4">
        <h1 class="text-2xl font-bold text-slate-800">백엔드 API 연결 테스트</h1>

        <div class="bg-slate-100 rounded-lg p-3 text-sm text-slate-700">
          <div class="font-semibold mb-1">고정 엔드포인트</div>
          <div class="font-mono break-all">{{ endpoint }}</div>
        </div>

        <div class="flex gap-2">
          <button
            @click="callApi"
            :disabled="loading"
            class="px-4 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 disabled:opacity-50"
          >
            {{ loading ? '요청 중...' : 'API 호출(GET)' }}
          </button>
        </div>

        <div class="pt-2">
          <h2 class="text-sm font-semibold text-slate-700 mb-2">응답</h2>
          <pre class="bg-slate-900 text-slate-100 p-4 rounded-lg text-sm overflow-auto min-h-40">{{ output }}</pre>
        </div>
      </div>
    </div>

    <script>
      const { createApp } = Vue;
      const API_ENDPOINT = 'http://localhost:8080/api/posts?page=1&limit=20';

      createApp({
        data() {
          return {
            endpoint: API_ENDPOINT,
            loading: false,
            output: '아직 요청하지 않았습니다.',
          };
        },
        methods: {
          async callApi() {
            this.loading = true;
            this.output = '요청 중...';

            try {
              const res = await fetch(this.endpoint, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' },
              });

              const text = await res.text();
              let parsed;
              try { parsed = JSON.parse(text); } catch { parsed = text; }

              this.output = JSON.stringify({
                ok: res.ok,
                status: res.status,
                statusText: res.statusText,
                data: parsed,
              }, null, 2);
            } catch (err) {
              this.output = JSON.stringify({
                error: true,
                message: err?.message || String(err),
              }, null, 2);
            } finally {
              this.loading = false;
            }
          },
        },
      }).mount('#app');
    </script>
  </body>
</html>
